{
    "name": "mchekhashvili/tax-legislation",
    "description": "Tax law over time, per country, for Laravel: legal acts, tax types, rates, thresholds, exemptions and tables with their history, and an engine that runs each country's taxes as pipelines.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "tax", "legislation", "law", "history", "pipeline", "vat"],
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/pipeline": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "mchekhashvili/countries": "^1.0@dev",
        "mchekhashvili/money": "^1.0@dev"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Mchekhashvili\\TaxLegislation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mchekhashvili\\TaxLegislation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Mchekhashvili\\TaxLegislation\\TaxLegislationServiceProvider"],
            "aliases": {"Taxes": "Mchekhashvili\\TaxLegislation\\Facades\\Taxes"}
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
